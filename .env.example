# ==============================================================================
# KaamSaathi Production Environment Configuration Template (.env.example)
# DO NOT COMMIT SECRETS TO REPOSITORY.
# ==============================================================================

# Application Environment ('production', 'development', 'test')
APP_ENV=production
DEBUG=false
PORT=8080
HOST=0.0.0.0

# Database Configuration (PostgreSQL in production)
# Example: postgresql://user:password@localhost:5432/kaamsaathi_prod
DATABASE_URL=postgresql://kaamsaathi_user:CHANGE_ME_IN_PROD@localhost:5432/kaamsaathi_db

# Security & Cryptographic Keys
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_HEX_SECRET_IN_PRODUCTION

# Super Administrator Credentials (Initial Provisioning Only)
ADMIN_EMAIL=admin@kaamsaathi.com
ADMIN_INITIAL_PASSWORD=CHANGE_INITIAL_ADMIN_PASSWORD_IMMEDIATELY

# CORS Allowed Origins (Comma-separated, no wildcards in production)
CORS_ALLOWED_ORIGINS=https://kaamsaathi.com,https://admin.kaamsaathi.com

# Payment Gateway Configuration (e.g. Razorpay)
PAYMENT_PROVIDER_KEY=rzp_live_your_key_here
PAYMENT_PROVIDER_SECRET=your_razorpay_secret_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# Communication & Notification Services (Email / SMS)
EMAIL_PROVIDER_KEY=sendgrid_or_smtp_key_here
SMS_PROVIDER_KEY=twilio_or_msg91_key_here
SUPPORT_EMAIL=support@kaamsaathi.com
SUPPORT_PHONE=+91 99000 88776

# Storage & Private Buckets (AWS S3 or GCS for private KYC documents)
STORAGE_BUCKET=kaamsaathi-private-kyc-docs
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

# AI Assistant API (e.g. Google Gemini API Key)
AI_API_KEY=your_gemini_api_key_here
